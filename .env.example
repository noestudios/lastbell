# lastbell configuration.
# Easiest path: run `lastbell setup` — it writes and updates the settings
# file for you (in your user config dir). This template is for the manual /
# checkout route: copy it to `.env` and fill it in. `.env` is git-ignored —
# it never gets committed, so your district, username, and settings stay
# local, and a `.env` in the working directory takes precedence over the
# installed settings file.
#
# IMPORTANT: passwords do NOT belong in this file. See "Secrets" in the README.
#   bare-metal  -> stored in your OS keyring  (run: lastbell set-password)
#   container   -> `docker compose run --rm lastbell setup` writes it to the
#                  settings file on the volume (data/env, owner-only); a secret
#                  file named by LASTBELL_PASSWORD_FILE (/run/secrets/…) also works
#   CI          -> injected via the secret store into LASTBELL_PASSWORD
#   always-on box with no usable keyring (headless Pi, boot-time service)
#               -> `lastbell setup` offers LASTBELL_SECRET_BACKEND=env and
#                  writes LASTBELL_PASSWORD here, owner-only (mode 0600) —
#                  on disk in plain text; that trade-off is yours to accept.

# District portal hostname — no scheme, no path.
LASTBELL_DISTRICT=md-mcps-psv.edupoint.com

# Primary ParentVUE credential: the login ID only (never the password).
LASTBELL_USERNAME=your_parentvue_username

# Where this credential's password is read from:
#   keyring -> OS keyring via the `keyring` library (recommended, bare-metal)
#   env     -> read from LASTBELL_PASSWORD below (Docker/CI, or an always-on
#              box where a boot-time service can't unlock the keyring)
LASTBELL_SECRET_BACKEND=keyring
# LASTBELL_PASSWORD=          # only used when LASTBELL_SECRET_BACKEND=env
# LASTBELL_PASSWORD_SMTP=     # same, for the email channel's SMTP account

# Collection cadence and where local state lives. Polling is clamped to a
# 15-minute floor in code — be a good neighbor to your district's portal.
LASTBELL_POLL_MINUTES=180
# Database and snapshots default to your platform user-data dir
# (~/Library/Application Support/lastbell, ~/.local/share/lastbell, or
# %APPDATA%\lastbell). A source checkout usually pins them into the repo:
LASTBELL_DB_PATH=data/lastbell.db
LASTBELL_SNAPSHOT_DIR=data/snapshots
LASTBELL_SNAPSHOT_RETENTION_DAYS=90

# Time-based rules (Phase 2).
#   LOOKAHEAD_DAYS       -> alert when an assignment's due date enters this window
#   UNGRADED_GRACE_DAYS  -> days past due before "still ungraded" fires
LASTBELL_LOOKAHEAD_DAYS=7
LASTBELL_UNGRADED_GRACE_DAYS=3

# Notifications (Phase 1+). `console` just prints; `email` uses the SMTP_* vars.
LASTBELL_NOTIFY_CHANNEL=console
# LASTBELL_SMTP_HOST=
# LASTBELL_SMTP_PORT=587
# LASTBELL_SMTP_USER=
# LASTBELL_SMTP_FROM=lastbell@example.com
# LASTBELL_SMTP_TO=you@example.com
# The SMTP account password never goes here: `lastbell setup` stores it in
# the OS keyring; Docker/CI installs inject LASTBELL_PASSWORD_SMTP instead.

# ── Phase 3: per-watcher channels ─────────────────────────────────────
# Watchers and subscriptions live in the database (see `lastbell watcher`
# and `lastbell subscribe`); only the channel *transports* are configured
# here. Each watcher's own address (email, topic, chat id, user key) is set via
# `watcher add --channel …` / `watcher set-channel`.
#
# email — uses the SMTP_* settings above; per-watcher recipients replace SMTP_TO.
#         SMS rides email for free: use a carrier gateway address as the
#         watcher's email, e.g. 3015551234@vtext.com (Verizon), @txt.att.net (AT&T),
#         @tmomail.net (T-Mobile).
#
# ntfy — free push to any phone via the ntfy app. Defaults to the public
#        https://ntfy.sh; topic names are effectively passwords, pick long ones.
# LASTBELL_NTFY_SERVER=https://ntfy.sh
# LASTBELL_NTFY_TOKEN=          # only for auth-protected self-hosted servers

# telegram — create a bot with @BotFather; each watcher messages it once and
#            their chat id becomes their address.
# LASTBELL_TELEGRAM_TOKEN=

# pushover — register an application at pushover.net; each watcher's user key
#            is their address.
# LASTBELL_PUSHOVER_TOKEN=

# ── Phase 3: web dashboard (read-only, on demand) ─────────────────────
# `lastbell dashboard` binds localhost only. Set HOST=0.0.0.0 to share on
# your LAN — the dashboard shows full names, so the bind address is the access
# control.
LASTBELL_DASHBOARD_HOST=127.0.0.1
LASTBELL_DASHBOARD_PORT=8321
# The dashboard answers only to names it recognizes — localhost, IP addresses,
# .local names, the bound address — and refuses any other Host header (that is
# the DNS-rebinding defence). Add your own names for this machine here,
# comma-separated: a Tailscale name, a home-DNS name.
# LASTBELL_DASHBOARD_HOSTNAMES=grades.tail1234.ts.net,nas.home.arpa
# Beyond loopback, other devices need the dashboard key once (a cookie, set
# from the link the dashboard prints). Generated and written here on first
# widened start; set it yourself to pick one (Docker: LASTBELL_DASHBOARD_KEY_FILE).
# LASTBELL_DASHBOARD_KEY=

# ── Heartbeat: notice when it stops ───────────────────────────────────
# Optional. Fetched once after every successful poll and never otherwise.
# Point it at a dead-man's-switch monitor (a healthchecks.io check, an
# Uptime Kuma push monitor) and *that* service tells you when the pings
# stop — the one failure a stopped Last Bell can't report for itself.
# LASTBELL_HEARTBEAT_URL=https://hc-ping.com/your-check-uuid

# ── Phase 4: grade-drop threshold ─────────────────────────────────────
# A course-percent drop of at least this many points becomes a GRADE_DROP
# alert (louder wording, separately subscribable) instead of a plain change.
LASTBELL_GRADE_DROP_POINTS=5

# ── Canvas (myMCPS Classroom) — the leading source ────────────────────
# ParentVUE is the gradebook of record; Canvas is where assignments, due
# dates, and "missing" flags appear first. `auto` (the default) follows the
# Canvas link on the portal's own home page with the ParentVUE session — no
# second password. `off` never touches Canvas.
LASTBELL_CANVAS=auto
# Optional. With a personal access token stored via `lastbell set-canvas-token`
# (or LASTBELL_CANVAS_TOKEN in the environment), the poll talks to this host
# directly and skips the portal hand-off. Hostname only.
# LASTBELL_CANVAS_HOST=mcpsmd.instructure.com
# Optional. Canvas courses that match a gradebook class always count; one that
# matches nothing gets its own row only if it sits in the same Canvas term as
# the real classes. To silence a specific shell anyway, list name fragments:
# LASTBELL_CANVAS_SKIP=Password Reset,Expectations Training

# ── Dashboard display: score cutoff ───────────────────────────────────
# Graded scores below this percentage tint red on the dashboard. Display
# only — nothing alerts on it. Set 0 to turn the tint off.
LASTBELL_SCORE_CUTOFF=70

# Digests, daily summaries, quiet hours, and shared ack are per-watcher, not
# env settings — see:
#   lastbell subscribe <watcher> <student> --at 17:00        (digest)
#   lastbell subscribe <watcher> <student> --types daily_summary --at 07:00
#   lastbell watcher quiet-hours <watcher> 21:00-07:00
#   lastbell alerts / ack <id> --by <watcher>
