# gradewatch configuration.
# Copy this file to `.env` and fill it in. `.env` is git-ignored — it never
# gets committed, so your district, username, and settings stay local.
#
# IMPORTANT: passwords do NOT belong in this file. See "Secrets" in the README.
#   bare-metal  -> stored in your OS keyring  (run: gradewatch set-password)
#   Docker / CI -> injected via a secret store into GRADEWATCH_PASSWORD

# District portal hostname — no scheme, no path.
GRADEWATCH_DISTRICT=md-mcps-psv.edupoint.com

# Primary ParentVUE credential: the login ID only (never the password).
GRADEWATCH_USERNAME=your_parentvue_username

# Where this credential's password is read from:
#   keyring -> OS keyring via the `keyring` library (recommended, bare-metal)
#   env     -> read from GRADEWATCH_PASSWORD below (Docker/CI only)
GRADEWATCH_SECRET_BACKEND=keyring
# GRADEWATCH_PASSWORD=          # only used when GRADEWATCH_SECRET_BACKEND=env

# Collection cadence and where local state lives.
GRADEWATCH_POLL_MINUTES=180
GRADEWATCH_DB_PATH=data/gradewatch.db
GRADEWATCH_SNAPSHOT_DIR=data/snapshots
GRADEWATCH_SNAPSHOT_RETENTION_DAYS=90

# Notifications (Phase 1+). `console` just prints; `email` uses the SMTP_* vars.
GRADEWATCH_NOTIFY_CHANNEL=console
# GRADEWATCH_SMTP_HOST=
# GRADEWATCH_SMTP_PORT=587
# GRADEWATCH_SMTP_USER=
# GRADEWATCH_SMTP_FROM=gradewatch@example.com
# GRADEWATCH_SMTP_TO=you@example.com
