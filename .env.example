# mcpsgradewatch configuration.
# Copy this file to `.env` and fill it in. `.env` is git-ignored — it never
# gets committed, so your district, username, and settings stay local.
#
# IMPORTANT: passwords do NOT belong in this file. See "Secrets" in the README.
#   bare-metal  -> stored in your OS keyring  (run: mcpsgradewatch set-password)
#   Docker / CI -> injected via a secret store into MCPSGRADEWATCH_PASSWORD

# District portal hostname — no scheme, no path.
MCPSGRADEWATCH_DISTRICT=md-mcps-psv.edupoint.com

# Primary ParentVUE credential: the login ID only (never the password).
MCPSGRADEWATCH_USERNAME=your_parentvue_username

# Where this credential's password is read from:
#   keyring -> OS keyring via the `keyring` library (recommended, bare-metal)
#   env     -> read from MCPSGRADEWATCH_PASSWORD below (Docker/CI only)
MCPSGRADEWATCH_SECRET_BACKEND=keyring
# MCPSGRADEWATCH_PASSWORD=          # only used when MCPSGRADEWATCH_SECRET_BACKEND=env

# Collection cadence and where local state lives.
MCPSGRADEWATCH_POLL_MINUTES=180
MCPSGRADEWATCH_DB_PATH=data/mcpsgradewatch.db
MCPSGRADEWATCH_SNAPSHOT_DIR=data/snapshots
MCPSGRADEWATCH_SNAPSHOT_RETENTION_DAYS=90

# Time-based rules (Phase 2).
#   LOOKAHEAD_DAYS       -> alert when an assignment's due date enters this window
#   UNGRADED_GRACE_DAYS  -> days past due before "still ungraded" fires
MCPSGRADEWATCH_LOOKAHEAD_DAYS=7
MCPSGRADEWATCH_UNGRADED_GRACE_DAYS=3

# Notifications (Phase 1+). `console` just prints; `email` uses the SMTP_* vars.
MCPSGRADEWATCH_NOTIFY_CHANNEL=console
# MCPSGRADEWATCH_SMTP_HOST=
# MCPSGRADEWATCH_SMTP_PORT=587
# MCPSGRADEWATCH_SMTP_USER=
# MCPSGRADEWATCH_SMTP_FROM=mcpsgradewatch@example.com
# MCPSGRADEWATCH_SMTP_TO=you@example.com

# ── Phase 3: per-watcher channels ─────────────────────────────────────
# Watchers and subscriptions live in the database (see `mcpsgradewatch watcher`
# and `mcpsgradewatch subscribe`); only the channel *transports* are configured
# here. Each watcher's own address (email, topic, chat id, user key) is set via
# `watcher add --channel …` / `watcher set-channel`.
#
# email — uses the SMTP_* settings above; per-watcher recipients replace SMTP_TO.
#         SMS rides email for free: use a carrier gateway address as the
#         watcher's email, e.g. 3015551234@vtext.com (Verizon), @txt.att.net (AT&T),
#         @tmomail.net (T-Mobile).
#
# ntfy — free push to any phone via the ntfy app. Defaults to the public
#        https://ntfy.sh; topic names are effectively passwords, pick long ones.
# MCPSGRADEWATCH_NTFY_SERVER=https://ntfy.sh
# MCPSGRADEWATCH_NTFY_TOKEN=          # only for auth-protected self-hosted servers

# telegram — create a bot with @BotFather; each watcher messages it once and
#            their chat id becomes their address.
# MCPSGRADEWATCH_TELEGRAM_TOKEN=

# pushover — register an application at pushover.net; each watcher's user key
#            is their address.
# MCPSGRADEWATCH_PUSHOVER_TOKEN=

# ── Phase 3: web dashboard (read-only, on demand) ─────────────────────
# `mcpsgradewatch dashboard` binds localhost only. Set HOST=0.0.0.0 to share on
# your LAN — the dashboard shows full names, so the bind address is the access
# control.
MCPSGRADEWATCH_DASHBOARD_HOST=127.0.0.1
MCPSGRADEWATCH_DASHBOARD_PORT=8321

# ── Phase 4: grade-drop threshold ─────────────────────────────────────
# A course-percent drop of at least this many points becomes a GRADE_DROP
# alert (louder wording, separately subscribable) instead of a plain change.
MCPSGRADEWATCH_GRADE_DROP_POINTS=5

# Digests, daily summaries, quiet hours, and shared ack are per-watcher, not
# env settings — see:
#   mcpsgradewatch subscribe <watcher> <student> --at 17:00        (digest)
#   mcpsgradewatch subscribe <watcher> <student> --types daily_summary --at 07:00
#   mcpsgradewatch watcher quiet-hours <watcher> 21:00-07:00
#   mcpsgradewatch alerts / ack <id> --by <watcher>
